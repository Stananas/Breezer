// Queue panel: current playlist, clickable rows, closable.

import { IconBtn, Palette, TrackInfo } from "./elements.slint";

component QueueRow inherits Rectangle {
    in property <Palette> palette;
    in property <TrackInfo> track;
    in property <int> index;
    in property <bool> current;
    callback clicked(int);
    height: 44px;
    border-radius: root.palette.radius;
    background: root.current ? root.palette.surface2 : transparent;
    TouchArea {
        clicked => root.clicked(root.index);
        mouse-cursor: pointer;
    }
    HorizontalLayout {
        spacing: 10px;
        padding-left: 8px;
        Text {
            text: root.current ? "▶" : "♫";
            width: 26px;
            color: root.current ? root.palette.primary : root.palette.text-secondary;
            font-size: 12px;
            horizontal-alignment: center;
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.track.title;
                color: root.palette.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.track.artist;
                color: root.palette.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component QueuePanel inherits Rectangle {
    in property <Palette> palette;
    in property <[TrackInfo]> queue;
    in property <int> current-index;
    callback close-requested();
    callback play-index-requested(int);

    background: root.palette.surface;

    VerticalLayout {
        width: 100%;
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: @tr("Queue");
                color: root.palette.text;
                font-weight: 700;
            }
            IconBtn {
                palette: root.palette;
                icon: @image-url("icons/x.png");
                clicked => root.close-requested();
            }
        }
        Flickable {
        width: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                for track[idx] in root.queue: QueueRow {
                    palette: root.palette;
                    track: track;
                    index: idx;
                    current: idx == root.current-index;
                    clicked(i) => root.play-index-requested(i);
                }
            }
        }
    }
}