// Player bar: now playing (left), transport+progress (center), volume (right).
// Pinned at the bottom, all blocks absolutely anchored → left/right edges can
// never be displaced by layout centering.

import { BreezerSlider, IconBtn, Palette, TrackInfo } from "./elements.slint";

export component PlayerBar inherits Rectangle {
    in property <Palette> palette;
    in property <bool> playing;
    in property <float> position;
    in property <float> progress-duration;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume;
    in property <TrackInfo> current-track;
    callback toggle-requested();
    callback prev-requested();
    callback next-requested();
    callback seek-requested(float);
    callback volume-requested(float);

    height: 86px;
    background: root.palette.surface2;

    // top hairline
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: root.palette.surface;
    }

    // --- LEFT: now playing (cover + title/artist) --------------------------
    Rectangle {
        x: 16px;
        y: 0px;
        width: 260px;
        height: 100%;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 12px;
            alignment: center;
            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 8px;
                clip: true;
                background: root.palette.surface;
                Image {
                    width: 60px;
                    height: 60px;
                    source: root.current-track.cover;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                width: 180px;
                spacing: 3px;
                alignment: center;
                Text {
                    text: root.current-track.id >= 0 ? root.current-track.title : @tr("Breezer");
                    horizontal-alignment: left;
                    color: root.palette.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.current-track.artist;
                    horizontal-alignment: left;
                    color: root.palette.text-secondary;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }

    // --- RIGHT: volume (glued to the right edge) --------------------------
    Rectangle {
        x: root.width - 150px;
        y: 0px;
        width: 134px;
        height: 100%;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 8px;
            alignment: center;
            Image {
                width: 18px;
                height: 18px;
                source: root.volume > 0 ? @image-url("icons/volume-2.png") : @image-url("icons/volume-x.png");
                colorize: root.palette.text-secondary;
            }
            BreezerSlider {
                horizontal-stretch: 1;
                palette: root.palette;
                minimum: 0;
                maximum: 100;
                progress: clamp(root.volume / 100.0, 0.0, 1.0);
                changed(v) => root.volume-requested(v);
            }
        }
    }

    // --- CENTER: transport + progress (fills the space between) ------------
    Rectangle {
        x: 292px;
        y: 0px;
        width: root.width - 292px - 152px;
        height: 100%;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 10px;
            alignment: center;
            IconBtn { palette: root.palette; icon: @image-url("icons/skip-back.png"); clicked => root.prev-requested(); }
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.playing ? root.palette.surface : root.palette.primary;
                border-width: root.playing ? 1px : 0px;
                border-color: root.palette.surface;
                ta := TouchArea {
                    clicked => root.toggle-requested();
                    mouse-cursor: pointer;
                }
                Image {
                    width: 22px;
                    height: 22px;
                    source: root.playing ? @image-url("icons/pause.png") : @image-url("icons/play.png");
                    colorize: root.playing ? root.palette.primary : root.palette.on-primary;
                }
            }
            IconBtn { palette: root.palette; icon: @image-url("icons/skip-forward.png"); clicked => root.next-requested(); }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                BreezerSlider {
                    palette: root.palette;
                    minimum: 0;
                    maximum: root.progress-duration > 0 ? root.progress-duration : 1.0;
                    progress: clamp(root.position / (root.progress-duration > 0 ? root.progress-duration : 1.0), 0.0, 1.0);
                    changed(v) => root.seek-requested(v);
                }
                HorizontalLayout {
                    width: 100%;
                    Text { text: root.position-label; color: root.palette.text-secondary; font-size: 11px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.duration-label; color: root.palette.text-secondary; font-size: 11px; }
                }
            }
        }
    }
}