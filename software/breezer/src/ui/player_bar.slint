// Player bar: now playing, transport controls, seek + volume.
// Always pinned at the bottom of the dock layout.

import { BreezerSlider, IconBtn, Palette, TrackInfo } from "./elements.slint";

export component PlayerBar inherits Rectangle {
    in property <Palette> palette;
    in property <bool> playing;
    in property <float> position;
    in property <float> progress-duration;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume;
    in property <TrackInfo> current-track;
    callback toggle-requested();
    callback prev-requested();
    callback next-requested();
    callback seek-requested(float);
    callback volume-requested(float);

    height: 86px;
    background: root.palette.surface2;

    VerticalLayout {
        spacing: 0;
        // top hairline
        Rectangle {
            height: 1px;
            width: 100%;
            background: root.palette.surface;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 14px;
            alignment: center;

            // Cover thumbnail
            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 8px;
                clip: true;
                background: root.palette.surface;
                Image {
                    width: 60px;
                    height: 60px;
                    source: root.current-track.cover;
                }
            }

            // Title / artist
            VerticalLayout {
                width: 210px;
                spacing: 3px;
                alignment: center;
                Text {
                    text: root.current-track.id >= 0 ? root.current-track.title : @tr("Breezer");
                    color: root.palette.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.current-track.artist;
                    color: root.palette.text-secondary;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            // Transport controls
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                IconBtn { palette: root.palette; icon: "⏮"; clicked => root.prev-requested(); }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: root.playing ? root.palette.surface : root.palette.primary;
                    ta := TouchArea {
                        clicked => root.toggle-requested();
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: root.playing ? "⏸" : "▶";
                        width: 100%;
                        height: 100%;
                        font-size: 20px;
                        color: root.playing ? root.palette.primary : root.palette.on-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                IconBtn { palette: root.palette; icon: "⏭"; clicked => root.next-requested(); }
            }

            // Progress
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                BreezerSlider {
                    palette: root.palette;
                    minimum: 0;
                    maximum: root.progress-duration > 0 ? root.progress-duration : 1.0;
                    progress: clamp(root.position / (root.progress-duration > 0 ? root.progress-duration : 1.0), 0.0, 1.0);
                    changed(v) => root.seek-requested(v);
                }
                HorizontalLayout {
                    Text { text: root.position-label; color: root.palette.text-secondary; font-size: 11px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.duration-label; color: root.palette.text-secondary; font-size: 11px; }
                }
            }

            // Volume
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: "🔊";
                    width: 20px;
                    height: 100%;
                    color: root.palette.text-secondary;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                BreezerSlider {
                    width: 110px;
                    palette: root.palette;
                    minimum: 0;
                    maximum: 100;
                    progress: clamp(root.volume / 100.0, 0.0, 1.0);
                    changed(v) => root.volume-requested(v);
                }
            }
        }
    }
}