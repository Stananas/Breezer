// Player bar: now playing, transport controls, seek + volume, dockable.

import { BreezerSlider, IconBtn, Palette, TrackInfo } from "./elements.slint";

export component PlayerBar inherits Rectangle {
    in property <Palette> palette;
    in property <bool> playing;
    in property <float> position;
    in property <float> progress-duration;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume;
    in property <TrackInfo> current-track;
    callback toggle-requested();
    callback prev-requested();
    callback next-requested();
    callback seek-requested(float);
    callback volume-requested(float);

    height: 88px;
    background: root.palette.surface2;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        alignment: center;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 8px;
            clip: true;
            visible: root.current-track.id >= 0;
            background: root.palette.surface;
            Image {
                width: 56px;
                height: 56px;
                source: root.current-track.cover;
            }
        }
        VerticalLayout {
            width: 190px;
            spacing: 2px;
            Text {
                text: root.current-track.title;
                color: root.palette.text;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.current-track.artist;
                color: root.palette.text-secondary;
                font-size: 12px;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            IconBtn { palette: root.palette; icon: "⏮"; clicked => root.prev-requested(); }
            IconBtn { palette: root.palette; icon: root.playing ? "⏸" : "▶"; clicked => root.toggle-requested(); }
            IconBtn { palette: root.palette; icon: "⏭"; clicked => root.next-requested(); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            BreezerSlider {
                palette: root.palette;
                minimum: 0;
                maximum: root.progress-duration > 0 ? root.progress-duration : 1.0;
                progress: clamp(root.position / (root.progress-duration > 0 ? root.progress-duration : 1.0), 0.0, 1.0);
                changed(v) => root.seek-requested(v);
            }
            HorizontalLayout {
                Text { text: root.position-label; color: root.palette.text-secondary; font-size: 11px; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.duration-label; color: root.palette.text-secondary; font-size: 11px; }
            }
        }

        Text { text: "🔊"; color: root.palette.text-secondary; font-size: 14px; }
        BreezerSlider {
            width: 110px;
            palette: root.palette;
            minimum: 0;
            maximum: 100;
            progress: clamp(root.volume / 100.0, 0.0, 1.0);
            changed(v) => root.volume-requested(v);
        }
    }
}