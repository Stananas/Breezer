// Player bar — 100% absolute coordinates.
//  LEFT   cover + title/artist, vertically centered
//  CENTER transport (prev/play/next) ABOVE a narrower duration slider,
//         elapsed time at the slider's left end, total at the right end
//  RIGHT  volume slider + visible % tooltip (on block OR slider hover)

import { BreezerSlider, IconBtn, Palette, TrackInfo } from "./elements.slint";

export component PlayerBar inherits Rectangle {
    in property <Palette> palette;
    in property <bool> playing;
    in property <float> position;
    in property <float> progress-duration;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> volume;
    in property <string> volume-label;
    in property <TrackInfo> current-track;
    in property <bool> shuffle-on;
    in property <int> repeat-mode;
    in property <float> ui-zoom;
    callback toggle-requested();
    callback prev-requested();
    callback next-requested();
    callback shuffle-requested();
    callback repeat-requested();
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-reset-requested();
    callback seek-requested(float);
    callback volume-requested(float);

    height: 94px;
    background: root.palette.surface2;

    Rectangle { x: 0px; y: 0px; width: 100%; height: 1px; background: root.palette.surface; }

    // ------------------------------------------------------------------
    // LEFT — cover + title/artist, vertically centered
    // ------------------------------------------------------------------
    Rectangle {
        x: 16px;
        y: (root.height - 60px) / 2;
        width: 60px;
        height: 60px;
        border-radius: 8px;
        clip: true;
        background: root.palette.surface;
        Image {
            width: 60px;
            height: 60px;
            source: root.current-track.cover;
            image-fit: cover;
        }
    }
    Rectangle {
        x: 86px;
        y: 20px;
        width: 210px;
        height: 24px;
        clip: true;
        Text {
            width: 100%;
            height: 100%;
            text: root.current-track.id >= 0 ? root.current-track.title : @tr("Breezer");
            horizontal-alignment: left;
            vertical-alignment: center;
            color: root.palette.text;
            font-weight: 600;
        }
    }
    Rectangle {
        x: 86px;
        y: 48px;
        width: 210px;
        height: 20px;
        clip: true;
        Text {
            width: 100%;
            height: 100%;
            text: root.current-track.artist;
            horizontal-alignment: left;
            vertical-alignment: center;
            color: root.palette.text-secondary;
            font-size: 12px;
        }
    }

    // ------------------------------------------------------------------
    // CENTER — transport row + duration slider row
    // ------------------------------------------------------------------
    Rectangle {
        x: 312px + (root.width - 312px - 308px - 188px) / 2;
        y: 10px;
        width: 188px;
        height: 44px;
        // Shuffle — highlighted when active (official Deezer icon).
        Rectangle {
            x: 0px;
            y: 4px;
            width: 36px;
            height: 36px;
            border-radius: root.palette.radius;
            background: root.shuffle-on ? root.palette.primary : (shuffle-ta.has-hover ? root.palette.surface2 : transparent);
            shuffle-ta := TouchArea {
                clicked => root.shuffle-requested();
                mouse-cursor: pointer;
            }
            Image {
                x: 9px;
                y: 9px;
                width: 18px;
                height: 18px;
                source: @image-url("icons/shuffle.png");
                colorize: root.shuffle-on ? root.palette.on-primary : (shuffle-ta.has-hover ? root.palette.primary : root.palette.text);
            }
        }
        IconBtn {
            x: 36px; y: 4px;
            palette: root.palette;
            icon: @image-url("icons/skip-back.png");
            clicked => root.prev-requested();
        }
        pb := Rectangle {
            x: 72px;
            y: 0px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.playing ? root.palette.surface : root.palette.primary;
            border-width: root.playing ? 1px : 0px;
            border-color: root.palette.surface;
            ta := TouchArea {
                clicked => root.toggle-requested();
                mouse-cursor: pointer;
            }
            Image {
                x: (pb.width - 22px) / 2;
                y: (pb.height - 22px) / 2;
                width: 22px;
                height: 22px;
                source: root.playing ? @image-url("icons/pause.png") : @image-url("icons/play.png");
                colorize: root.playing ? root.palette.primary : root.palette.on-primary;
            }
        }
        IconBtn {
            x: 116px; y: 4px;
            palette: root.palette;
            icon: @image-url("icons/skip-forward.png");
            clicked => root.next-requested();
        }
        // Repeat — cycles Off → All → One (highlighted when active).
        Rectangle {
            x: 152px;
            y: 4px;
            width: 36px;
            height: 36px;
            border-radius: root.palette.radius;
            background: root.repeat-mode > 0 ? root.palette.primary : (repeat-ta.has-hover ? root.palette.surface2 : transparent);
            repeat-ta := TouchArea {
                clicked => root.repeat-requested();
                mouse-cursor: pointer;
            }
            Image {
                x: 8px;
                y: 8px;
                width: 20px;
                height: 20px;
                source: @image-url("icons/repeat.png");
                colorize: root.repeat-mode > 0 ? root.palette.on-primary : (repeat-ta.has-hover ? root.palette.primary : root.palette.text);
            }
            // Small "1" badge for repeat-one.
            if root.repeat-mode == 2: Rectangle {
                x: 20px;
                y: 4px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.palette.surface2;
                Text {
                    text: "1";
                    width: 100%;
                    height: 100%;
                    font-size: 8px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: root.palette.primary;
                }
            }
        }
    }

    // duration slider row — the whole unit (elapsed + slider + total) is
    // centered horizontally; the slider itself is capped at 440px.
    Rectangle {
        x: 312px;
        y: 62px;
        width: root.width - 312px - 308px;
        height: 26px;
        Rectangle {
            x: (root.width - 312px - 308px - min(root.width - 312px - 308px - 108px, 440px) - 108px) / 2;
            y: 0px;
            width: 42px;
            height: 26px;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: root.position-label;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: root.palette.text-secondary;
                font-size: 12px;
            }
        }
        BreezerSlider {
            x: (root.width - 312px - 308px - min(root.width - 312px - 308px - 108px, 440px) - 108px) / 2 + 54px;
            y: 0px;
            width: min(root.width - 312px - 308px - 108px, 440px);
            height: 26px;
            palette: root.palette;
            minimum: 0;
            maximum: root.progress-duration > 0 ? root.progress-duration : 1.0;
            progress: clamp(root.position / (root.progress-duration > 0 ? root.progress-duration : 1.0), 0.0, 1.0);
            changed(v) => root.seek-requested(v);
        }
        Rectangle {
            x: (root.width - 312px - 308px - min(root.width - 312px - 308px - 108px, 440px) - 108px) / 2 + 54px + min(root.width - 312px - 308px - 108px, 440px) + 12px;
            y: 0px;
            width: 42px;
            height: 26px;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: root.duration-label;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: root.palette.text-secondary;
                font-size: 12px;
            }
        }
    }

    // ------------------------------------------------------------------
    // RIGHT — zoom buttons + volume + visible tooltip
    // ------------------------------------------------------------------
    Rectangle {
        x: root.width - 160px - 148px;
        y: 0px;
        width: 148px;
        height: 100%;
        Rectangle {
            x: 6px;
            y: (root.height - 28px) / 2;
            width: 28px;
            height: 28px;
            border-radius: root.palette.radius;
            background: zim-ta.has-hover ? root.palette.surface : root.palette.surface;
            zim-ta := TouchArea {
                clicked => root.zoom-in-requested();
                mouse-cursor: pointer;
            }
            Text {
                text: "+";
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.palette.text;
                font-size: 15px;
                font-weight: 800;
            }
        }
        Text {
            x: 40px;
            y: 0px;
            width: 50px;
            height: 100%;
            text: Math.round(root.ui-zoom * 100.0) + "%";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
        }
        Rectangle {
            x: 96px;
            y: (root.height - 28px) / 2;
            width: 28px;
            height: 28px;
            border-radius: root.palette.radius;
            background: root.palette.surface;
            zom-ta := TouchArea {
                clicked => root.zoom-out-requested();
                mouse-cursor: pointer;
            }
            Text {
                text: "−";
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.palette.text;
                font-size: 15px;
                font-weight: 800;
            }
        }
        Rectangle {
            x: 126px;
            y: (root.height - 28px) / 2;
            width: 16px;
            height: 28px;
            zr-ta := TouchArea {
                clicked => root.zoom-reset-requested();
                mouse-cursor: pointer;
            }
            Text {
                text: "0";
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.palette.text-secondary;
                font-size: 11px;
                font-weight: 700;
            }
        }
    }

    // Volume
    Rectangle {
        x: root.width - 160px;
        y: 0px;
        width: 160px;
        height: 100%;
        vta := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
        }
        // Tooltip: above the volume block; shown on hover of the block OR the
        // volume slider itself.
        Rectangle {
            x: root.width - 160px + 35px;
            y: -28px;
            width: 90px;
            height: 24px;
            visible: vta.has-hover || vsl.hovered;
            border-radius: 6px;
            background: root.palette.bg;
            border-width: 1px;
            border-color: root.palette.primary;
            Text {
                text: root.volume-label + " %";
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.palette.text;
                font-size: 13px;
                font-weight: 600;
            }
        }
        Image {
            x: 4px;
            y: vsl.y + (vsl.height - 18px) / 2;
            width: 18px;
            height: 18px;
            source: root.volume <= 0 ? @image-url("icons/volume-x.png") :
                     (root.volume < 66 ? @image-url("icons/volume-1.png") : @image-url("icons/volume-2.png"));
            colorize: root.palette.text-secondary;
        }
        vsl := BreezerSlider {
            x: 30px;
            y: (root.height - 20px) / 2;
            width: 126px;
            height: 26px;
            palette: root.palette;
            minimum: 0;
            maximum: 100;
            progress: clamp(root.volume / 100.0, 0.0, 1.0);
            changed(v) => root.volume-requested(v);
        }
    }
}