// Sidebar: navigation (incl. Settings) + Deezer login (ARL) + a scrollable
// list of the user's playlists (cover + name) that extends down to the player.

import { Palette, PlaylistInfo } from "./elements.slint";

component NavItem inherits Rectangle {
    in property <Palette> palette;
    in property <string> label;
    in property <image> icon;
    in property <string> value;
    in property <string> current;
    callback clicked(string);
    height: 36px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface2 :
                (root.current == root.value ? root.palette.surface2 : transparent);
    ta := TouchArea {
        clicked => root.clicked(root.value);
        mouse-cursor: pointer;
    }
    HorizontalLayout {
        width: 100%;
        padding-left: 10px;
        spacing: 10px;
        alignment: center;
        Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: root.current == root.value ? root.palette.primary : root.palette.text;
        }
        Text {
            text: root.label;
            horizontal-stretch: 1;
            color: root.current == root.value ? root.palette.primary : root.palette.text;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <Palette> palette;
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    border-radius: root.palette.radius;
    background: !root.enabled ? root.palette.surface2 :
                (root.primary ? (ta.has-hover ? root.palette.primary : root.palette.primary) :
                (ta.has-hover ? root.palette.surface2 : root.palette.surface2));
    opacity: root.enabled ? 1.0 : 0.45;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
        mouse-cursor: pointer;
    }
    Text {
        text: root.label;
        width: 100%;
        height: 100%;
        color: root.enabled && root.primary ? root.palette.on-primary : root.palette.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One playlist row: cover thumbnail + name, clickable (left aligned).
component PlaylistRow inherits Rectangle {
    in property <Palette> palette;
    in property <PlaylistInfo> playlist;
    callback clicked(string);
    height: 44px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface2 : transparent;
    ta := TouchArea {
        clicked => root.clicked(root.playlist.id);
        mouse-cursor: pointer;
    }
    HorizontalLayout {
        width: 100%;
        padding-left: 2px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            clip: true;
            background: root.palette.surface2;
            Image {
                width: 40px;
                height: 40px;
                source: root.playlist.cover;
                image-fit: cover;
            }
        }
        Text {
            text: root.playlist.title;
            horizontal-stretch: 1;
            color: root.palette.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <Palette> palette;
    in property <string> username;
    in property <int> auth-state;
    in property <string> current-view;
    in property <string> version-status;
    in property <[PlaylistInfo]> playlists;
    callback view-requested(string);
    callback connect-requested(string);
    callback open-browser-requested();
    callback playlist-selected(string);

    property <string> arl-input: "";

    background: root.palette.surface;

    VerticalLayout {
        width: 100%;
        padding: 16px;
        spacing: 8px;
        Text {
            text: "Breezer";
            font-size: 24px;
            font-weight: 800;
            color: root.palette.primary;
        }
        Text {
            text: @tr("Not connected");
            color: root.palette.text-secondary;
            font-size: 12px;
            visible: root.auth-state < 2;
        }
        Text {
            text: root.username;
            color: root.palette.accent;
            font-size: 12px;
            visible: root.auth-state >= 2;
        }

        NavItem { palette: root.palette; label: @tr("Home"); icon: @image-url("icons/home.png"); value: "home"; current: root.current-view; clicked(v) => root.view-requested(v); }
        NavItem { palette: root.palette; label: @tr("Favorites"); icon: @image-url("icons/heart.png"); value: "favorites"; current: root.current-view; clicked(v) => root.view-requested(v); }
        NavItem { palette: root.palette; label: @tr("Playlists"); icon: @image-url("icons/list-music.png"); value: "playlists"; current: root.current-view; clicked(v) => root.view-requested(v); }
        NavItem { palette: root.palette; label: @tr("Settings"); icon: @image-url("icons/settings.png"); value: "settings"; current: root.current-view; clicked(v) => root.view-requested(v); }

        Rectangle { height: 1px; background: root.palette.surface2; }

        if root.auth-state < 2: VerticalLayout {
            spacing: 6px;
            Text {
                text: @tr("Deezer login — ARL");
                color: root.palette.text-secondary;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: @tr("Paste your ARL cookie here:");
                color: root.palette.text;
                font-size: 12px;
                font-weight: 600;
            }
            Rectangle {
                height: 34px;
                border-width: 2px;
                border-color: root.arl-input != "" ? root.palette.primary : root.palette.surface2;
                border-radius: root.palette.radius;
                arl-field := TextInput {
                    height: 34px;
                    font-family: "monospace";
                    vertical-alignment: center;
                    text <=> root.arl-input;
                    edited => { root.arl-input = arl-field.text; }
                    color: root.palette.text;
                    accepted => root.connect-requested(root.arl-input);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                ActionButton {
                    palette: root.palette; label: @tr("Open Deezer");
                    clicked => root.open-browser-requested();
                }
                ActionButton {
                    palette: root.palette; label: @tr("Connect");
                    primary: true;
                    clicked => root.connect-requested(root.arl-input);
                }
            }
        }

        Rectangle { height: 1px; background: root.palette.surface2; }

        // Playlists — below the tabs, scrollable down to the player.
        Text {
            text: @tr("Playlists");
            color: root.palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
        }
        if root.playlists.length == 0:
            Text {
                text: @tr("Loading your playlists…");
                color: root.palette.text-secondary;
                font-size: 11px;
            }
        Flickable {
        width: 100%;
        height: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                padding: 2px;
                for p in root.playlists: PlaylistRow {
                    palette: root.palette;
                    playlist: p;
                    clicked(id) => root.playlist-selected(id);
                }
            }
        }

        Text {
            text: root.version-status;
            color: root.palette.text-secondary;
            font-size: 11px;
        }
    }
}