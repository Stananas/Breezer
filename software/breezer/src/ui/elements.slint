// Shared design tokens, types and small reusable widgets.

export struct Palette {
    bg: color,
    surface: color,
    surface2: color,
    primary: color,
    on-primary: color,
    accent: color,
    text: color,
    text-secondary: color,
    error: color,
    radius: length,
    spacing: length,
}

export struct TrackInfo {
    id: int,
    title: string,
    artist: string,
    album: string,
    cover: image,
    duration: float,
    duration-label: string,
}

export struct PlaylistInfo {
    id: string,
    title: string,
    count: int,
    cover: image,
}

export component IconBtn inherits Rectangle {
    in property <Palette> palette;
    in property <image> icon;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface2 : transparent;
    ta := TouchArea {
        clicked => root.clicked();
        mouse-cursor: pointer;
    }
    Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: ta.has-hover ? root.palette.primary : root.palette.text;
    }
}

export component BreezerSlider inherits Rectangle {
    in property <Palette> palette;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in property <float> progress: 0.0;
    callback changed(float);
    out property <bool> hovered: touch.has-hover;
    property <bool> dragging: false;
    property <float> drag-ratio: 0.0;
    property <float> ratio: root.dragging ? root.drag-ratio : root.progress;
    property <length> track-height: 4px;
    height: 26px;
    // track — explicit x:0 (free-positioned children default to centering!)
    Rectangle {
        x: 0px;
        y: (root.height - root.track-height) / 2;
        height: root.track-height;
        width: root.width;
        border-radius: root.track-height / 2;
        background: root.palette.surface;
        Rectangle {
            x: 0px;
            width: root.width * root.ratio;
            height: root.track-height;
            border-radius: root.track-height / 2;
            background: root.palette.primary;
        }
    }
    // handle
    Rectangle {
        x: root.width * root.ratio - 6px;
        y: (root.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.palette.on-primary;
        border-width: 2px;
        border-color: root.palette.primary;
        visible: touch.has-hover || root.dragging;
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.dragging = true;
                root.drag-ratio = clamp(touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.minimum + (root.maximum - root.minimum) * root.drag-ratio);
            }
            if event.kind == PointerEventKind.up {
                root.changed(root.minimum + (root.maximum - root.minimum) * root.drag-ratio);
                root.dragging = false;
            }
        }
        moved => {
            if root.dragging {
                root.drag-ratio = clamp(touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.minimum + (root.maximum - root.minimum) * root.drag-ratio);
            }
        }
        mouse-cursor: pointer;
    }
}

export component CoverCard inherits Rectangle {
    in property <Palette> palette;
    in property <TrackInfo> track;
    callback clicked(int);
    width: 168px;
    height: 210px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface2 : root.palette.surface;
    ta := TouchArea {
        clicked => root.clicked(root.track.id);
        mouse-cursor: pointer;
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            width: 148px;
            height: 148px;
            border-radius: root.palette.radius;
            clip: true;
            background: root.palette.surface2;
            Image {
                width: 148px;
                height: 148px;
                source: root.track.cover;
            }
        }
        Text {
            text: root.track.title;
            color: root.palette.text;
            font-weight: 600;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.track.artist;
            color: root.palette.text-secondary;
            font-size: 12px;
            overflow: elide;
        }
    }
}

// Medium horizontal-shelf tile (Home "recently played" / Deezer shelf style).
export component MidCard inherits Rectangle {
    in property <Palette> palette;
    in property <TrackInfo> track;
    callback clicked(int);
    width: 152px;
    height: 196px;
    ta := TouchArea {
        clicked => root.clicked(root.track.id);
        mouse-cursor: pointer;
    }
    VerticalLayout {
        spacing: 7px;
        Rectangle {
            width: 152px;
            height: 152px;
            border-radius: root.palette.radius;
            clip: true;
            background: root.palette.surface;
            Image {
                source: root.track.cover;
                width: 152px;
                height: 152px;
                image-fit: cover;
            }
            // Play overlay on hover, like Deezer columns.
            Rectangle {
                x: 0px;
                y: 0px;
                width: 152px;
                height: 152px;
                visible: ta.has-hover;
                background: root.palette.bg;
                opacity: 0.45;
            }
            pb := Rectangle {
                x: 152px - 58px;
                y: 152px - 58px;
                width: 42px;
                height: 42px;
                border-radius: 21px;
                visible: ta.has-hover;
                background: root.palette.primary;
                Image {
                    x: (pb.width - 18px) / 2;
                    y: (pb.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/play.png");
                    colorize: root.palette.on-primary;
                }
            }
        }
        Text {
            text: root.track.title;
            color: root.palette.text;
            font-weight: 600;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.track.artist;
            color: root.palette.text-secondary;
            font-size: 12px;
            overflow: elide;
        }
    }
}

// Playlist tile for the Home shelf.
export component PlaylistTile inherits Rectangle {
    in property <Palette> palette;
    in property <PlaylistInfo> playlist;
    callback clicked(string);
    width: 152px;
    height: 178px;
    ta := TouchArea {
        clicked => root.clicked(root.playlist.id);
        mouse-cursor: pointer;
    }
    VerticalLayout {
        spacing: 7px;
        Rectangle {
            width: 152px;
            height: 152px;
            border-radius: root.palette.radius;
            clip: true;
            background: root.palette.surface;
            Image {
                source: root.playlist.cover;
                width: 152px;
                height: 152px;
                image-fit: cover;
            }
            Rectangle {
                width: 100%;
                height: 100%;
                visible: ta.has-hover;
                background: root.palette.bg;
                opacity: 0.45;
            }
        }
        Text {
            text: root.playlist.title;
            color: root.palette.text;
            font-weight: 600;
            font-size: 13px;
            overflow: elide;
        }
    }
}