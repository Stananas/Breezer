// Content area: search + result grid, and the Settings view (theme, language,
// custom colors, layout).

import { CoverCard, MidCard, Palette, PlaylistInfo, PlaylistTile, TrackInfo } from "./elements.slint";

// Small selectable chip (language / theme).
component Chip inherits Rectangle {
    in property <Palette> palette;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 28px;
    border-radius: 14px;
    background: root.active ? root.palette.primary :
                (ta.has-hover ? root.palette.surface : root.palette.surface2);
    ta := TouchArea {
        clicked => root.clicked();
        mouse-cursor: pointer;
    }
    Text {
        text: root.label;
        width: 100%;
        height: 100%;
        font-size: 12px;
        color: root.active ? root.palette.on-primary : root.palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Settings action button.
component SettingsBtn inherits Rectangle {
    in property <Palette> palette;
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface : root.palette.surface2;
    ta := TouchArea {
        clicked => root.clicked();
        mouse-cursor: pointer;
    }
    Text {
        text: root.label;
        width: 100%;
        height: 100%;
        color: root.palette.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One editable custom-theme token (hex color or number) + hint.
component ColorRow inherits Rectangle {
    in property <Palette> palette;
    in property <string> token;
    in property <string> label;
    in property <string> hint;
    callback changed(string, string);
    property <string> hex: "";
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.label;
                width: 110px;
                color: root.palette.text;
                font-size: 12px;
                font-weight: 600;
            }
            TextInput {
                horizontal-stretch: 1;
                height: 30px;
                vertical-alignment: center;
                text <=> root.hex;
                edited => { root.changed(root.token, root.hex); }
                color: root.palette.text;
                font-family: "monospace";
                accepted => { root.changed(root.token, root.hex); }
            }
        }
        Text {
            text: root.hint;
            color: root.palette.text-secondary;
            font-size: 11px;
        }
    }
}

// One playlist track row (Deezer-style list): cover, title/artist, album, duration.
component TrackRow inherits Rectangle {
    in property <Palette> palette;
    in property <TrackInfo> track;
    callback clicked(int);
    height: 54px;
    border-radius: root.palette.radius;
    background: ta.has-hover ? root.palette.surface2 : transparent;
    ta := TouchArea {
        clicked => root.clicked(root.track.id);
        mouse-cursor: pointer;
    }
    // Cover thumbnail + play overlay on hover.
    Rectangle {
        x: 4px;
        y: 5px;
        width: 44px;
        height: 44px;
        border-radius: 6px;
        clip: true;
        background: root.palette.surface2;
        Image {
            source: root.track.cover;
            width: 44px;
            height: 44px;
            image-fit: cover;
        }
        Rectangle {
            x: 0px; y: 0px; width: 44px; height: 44px;
            visible: ta.has-hover;
            background: root.palette.bg;
            opacity: 0.55;
        }
        if ta.has-hover: Image {
            x: (44px - 16px) / 2;
            y: (44px - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("icons/play.png");
            colorize: root.palette.on-primary;
        }
    }
    // Title / artist.
    Rectangle {
        x: 56px;
        y: 0px;
        width: max(root.width - 56px - 200px - 90px, 120px);
        height: root.height;
        clip: true;
        VerticalLayout {
            spacing: 2px;
            padding-top: 9px;
            Text {
                text: root.track.title;
                color: root.palette.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.track.artist;
                color: root.palette.text-secondary;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    // Album.
    Rectangle {
        x: root.width - 178px - 90px + 4px;
        y: 0px;
        width: 174px;
        height: root.height;
        clip: true;
        Text {
            text: root.track.album;
            color: root.palette.text-secondary;
            font-size: 12px;
            overflow: elide;
            width: 100%;
            height: 100%;
            vertical-alignment: center;
        }
    }
    // Duration.
    Rectangle {
        x: root.width - 84px;
        y: 0px;
        width: 76px;
        height: root.height;
        Text {
            text: root.track.duration-label;
            color: root.palette.text-secondary;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}

export component ContentView inherits Rectangle {
    in property <Palette> palette;
    in property <[TrackInfo]> results;
    in property <[PlaylistInfo]> playlist-results;
    in property <string> status;
    in property <string> view-title;
    in property <string> current-view;
    in property <string> theme-id;
    in property <string> ui-language;
    in property <string> username;
    in property <TrackInfo> current-track;
    in property <[TrackInfo]> recents;
    in property <float> ui-zoom;
    in property <string> playlist-title;
    in property <image> playlist-cover;
    in property <string> playlist-stats;
    in property <bool> playing;
    callback toggle-requested();
    callback play-recent-requested(int);
    callback explore-requested();
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-reset-requested();
    callback shuffle-requested();
    callback search-requested(string);
    callback play-requested(int);
    callback playlist-selected(string);
    callback back-requested();
    callback theme-changed(string);
    callback language-changed(string);
    callback theme-override-requested(string, string);
    callback reset-theme-overrides-requested();
    callback save-layout-requested();
    callback reset-layout-requested();
    callback toggle-right-panel-requested();

    property <string> query: "";
    property <bool> show-theme-editor: false;

    background: root.palette.bg;

    // ----------------------------------------------------------------
    // SEARCH VIEW (home / favorites)
    // ----------------------------------------------------------------
    if root.current-view != "settings" && root.current-view != "playlists" && root.current-view != "playlist-detail": VerticalLayout {
    width: 100%;
    height: 100%;
        padding-left: root.palette.spacing;
        padding-right: root.palette.spacing;
        padding-top: root.palette.spacing;
        padding-bottom: root.palette.spacing;
        spacing: root.palette.spacing;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.view-title;
                font-size: 22px;
                font-weight: 800;
                color: root.palette.text;
            }
            Rectangle { horizontal-stretch: 1; }
            // Visible, styled search input.
            Rectangle {
                width: 300px;
                height: 36px;
                border-radius: root.palette.radius;
                background: root.palette.surface;
                border-width: 1px;
                border-color: root.palette.surface2;
                // Official Deezer search magnifier inside the field.
                Image {
                    x: 10px;
                    y: 9px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/search.png");
                    colorize: root.palette.text-secondary;
                }
                search-field := TextInput {
                    x: 34px;
                    y: 0px;
                    height: 36px;
                    width: 256px;
                    vertical-alignment: center;
                    text <=> root.query;
                    color: root.palette.text;
                    accepted => root.search-requested(root.query);
                }
            }
            Rectangle {
                height: 36px;
                border-radius: root.palette.radius;
                background: root.palette.primary;
                TouchArea {
                    clicked => root.search-requested(root.query);
                    mouse-cursor: pointer;
                }
                Text {
                    text: @tr("Search");
                    width: 100%;
                    height: 100%;
                    color: root.palette.on-primary;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            } // end search bar row

        // ---- HOME PAGE content ----------------------------------------
        if root.current-view == "home": Flickable {
            width: 100%;
            vertical-stretch: 1;
            VerticalLayout {
            width: 100%;
            spacing: 14px;

            // Greeting + quick link to the Explorer (trending) page.
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: @tr("Welcome back") + (root.username != "" ? ", " + root.username : "");
                    color: root.palette.text-secondary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                link := Rectangle {
                    height: 26px;
                    link-ta := TouchArea {
                        clicked => root.explore-requested();
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: @tr("See what's trending") + " →";
                        height: 100%;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: root.palette.primary;
                        font-size: 12px;
                        font-weight: 700;
                    }
                }
            }

            // Resume hero card — the last played track (loaded paused).
            if root.current-track.id >= 0: Rectangle {
                height: 138px;
                border-radius: root.palette.radius * 2;
                background: root.palette.surface;
                border-width: 1px;
                border-color: root.palette.surface2;
                // Subtle Deezer-style accent tint under the track info.
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    background: root.palette.primary;
                    opacity: 0.08;
                }
                HorizontalLayout {
                    spacing: 16px;
                    padding: 15px;
                    Rectangle {
                        width: 106px;
                        height: 106px;
                        border-radius: root.palette.radius;
                        clip: true;
                        background: root.palette.surface2;
                        Image {
                            source: root.current-track.cover;
                            width: 106px;
                            height: 106px;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        vertical-stretch: 1;
                        Text {
                            text: @tr("Continue listening");
                            color: root.palette.primary;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.current-track.title;
                            color: root.palette.text;
                            font-size: 18px;
                            font-weight: 800;
                            overflow: elide;
                        }
                        Text {
                            text: root.current-track.artist;
                            color: root.palette.text-secondary;
                            font-size: 13px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 34px;
                            border-radius: root.palette.radius;
                            background: root.playing ? root.palette.surface2 : root.palette.primary;
                            hover-btn := TouchArea {
                                clicked => root.toggle-requested();
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: root.playing ? @tr("Pause") : @tr("Resume");
                                width: 100%;
                                height: 100%;
                                color: root.playing ? root.palette.text : root.palette.on-primary;
                                font-weight: 600;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.status != "":
                        Text {
                            text: root.status;
                            color: root.palette.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: right;
                        }
                }
            }

            // "Recently played" shelf — horizontal scroll, Deezer style.
            if root.recents.length > 0: VerticalLayout {
                spacing: 10px;
                Text {
                    text: @tr("Recently played");
                    color: root.palette.text;
                    font-size: 16px;
                    font-weight: 800;
                }
                Flickable {
                    width: 100%;
                    height: 198px;
                    HorizontalLayout {
                        spacing: 12px;
                        for t in root.recents: MidCard {
                            palette: root.palette;
                            track: t;
                            clicked(id) => root.play-recent-requested(id);
                        }
                    }
                }
            }

            // "Your playlists" shelf — quick access to the sidebar lists.
            if root.playlist-results.length > 0: VerticalLayout {
                spacing: 10px;
                Text {
                    text: @tr("Your playlists");
                    color: root.palette.text;
                    font-size: 16px;
                    font-weight: 800;
                }
                Flickable {
                    width: 100%;
                    height: 180px;
                    HorizontalLayout {
                        spacing: 12px;
                        for p in root.playlist-results: PlaylistTile {
                            palette: root.palette;
                            playlist: p;
                            clicked(id) => root.playlist-selected(id);
                        }
                    }
                }
            }
            }
        }

        if root.current-view == "explore" && root.results.length > 0:
            Text {
                text: @tr("Trending");
                color: root.palette.text;
                font-size: 16px;
                font-weight: 800;
            }

        if root.current-view != "home": Rectangle {
        width: 100%;
        height: 100%;
            vertical-stretch: 1;
            // Status hints only when there are no results yet — the grid must
            // never be hidden behind the "N results" summary.
            if root.status != "" && root.results.length == 0:
                Text {
                    text: root.status;
                    color: root.palette.text-secondary;
                }
            if root.results.length > 0:
                Flickable {
                width: 100%;
                height: 100%;
                    vertical-stretch: 1;
                    GridLayout {
                        spacing: 14px;
                        padding: 4px;
                        for track[idx] in root.results: CoverCard {
                            palette: root.palette;
                            track: track;
                            clicked(id) => root.play-requested(id);
                        }
                    }
                }
        }
    }

    // ----------------------------------------------------------------
    // PLAYLISTS VIEW (the list itself lives in the sidebar — here we just
    // point the user there when the tab is opened).
    // ----------------------------------------------------------------
    if root.current-view == "playlists": Rectangle {
    width: 100%;
    height: 100%;
        background: root.palette.bg;
        VerticalLayout {
            padding-left: root.palette.spacing;
            padding-right: root.palette.spacing;
            padding-top: root.palette.spacing;
            padding-bottom: root.palette.spacing;
            spacing: root.palette.spacing;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Playlists");
                    font-size: 22px;
                    font-weight: 800;
                    color: root.palette.text;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.status;
                    color: root.palette.text-secondary;
                    font-size: 12px;
                }
            }
            Text {
                text: @tr("Pick a playlist from the sidebar.");
                color: root.palette.text-secondary;
                font-size: 14px;
            }
        }
    }

    // ----------------------------------------------------------------
    // PLAYLIST DETAIL VIEW (Deezer-style playlist page)
    // ----------------------------------------------------------------
    if root.current-view == "playlist-detail": Rectangle {
    width: 100%;
    height: 100%;
        background: root.palette.bg;
        VerticalLayout {
            padding-left: root.palette.spacing;
            padding-right: root.palette.spacing;
            padding-top: root.palette.spacing;
            padding-bottom: root.palette.spacing;
            spacing: root.palette.spacing;

            // back row
            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                SettingsBtn {
                    palette: root.palette;
                    label: @tr("← Playlists");
                    clicked => root.back-requested();
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // playlist header card (cover, title, stats, Play / Shuffle)
            Rectangle {
                border-radius: root.palette.radius * 2;
                background: root.palette.surface;
                border-width: 1px;
                border-color: root.palette.surface2;
                HorizontalLayout {
                    spacing: 20px;
                    padding: 18px;
                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: root.palette.radius;
                        clip: true;
                        background: root.palette.surface2;
                        Image {
                            source: root.playlist-cover;
                            width: 120px;
                            height: 120px;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;
                        Text {
                            text: @tr("Playlist");
                            color: root.palette.primary;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.playlist-title;
                            color: root.palette.text;
                            font-size: 26px;
                            font-weight: 800;
                            overflow: elide;
                        }
                        Text {
                            text: root.playlist-stats;
                            color: root.palette.text-secondary;
                            font-size: 13px;
                        }
                        Rectangle {
                            height: 4px;
                            vertical-stretch: 1;
                        }
                        HorizontalLayout { spacing: 10px;
                            // Play all
                            Rectangle {
                                height: 40px;
                                border-radius: root.palette.radius;
                                background: root.palette.primary;
                                playta := TouchArea {
                                    clicked => {
                                        if root.results.length > 0 {
                                            root.play-requested(root.results[0].id);
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 18px;
                                    spacing: 8px;
                                    alignment: center;
                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/play.png");
                                        colorize: root.palette.on-primary;
                                    }
                                    Text {
                                        text: @tr("Play");
                                        color: root.palette.on-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                            }
                            // Shuffle
                            Rectangle {
                                height: 40px;
                                border-radius: root.palette.radius;
                                background: root.palette.surface2;
                                shuffta := TouchArea {
                                    clicked => {
                                        root.shuffle-requested();
                                        if root.results.length > 0 {
                                            root.play-requested(root.results[0].id);
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    alignment: center;
                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/shuffle.png");
                                        colorize: root.palette.text;
                                    }
                                    Text {
                                        text: @tr("Shuffle");
                                        color: root.palette.text;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // column header
            Rectangle {
                height: 22px;
                Text { text: @tr("Title"); x: 56px; y: 3px; width: 200px; color: root.palette.text-secondary; font-size: 11px; font-weight: 700; }
                Text { text: @tr("Album"); x: max(root.width - 56px - 356px, 256px) + 3px; y: 3px; width: 170px; color: root.palette.text-secondary; font-size: 11px; font-weight: 700; overflow: elide; }
                Text { text: @tr("Duration"); x: root.width - 90px; y: 3px; width: 76px; color: root.palette.text-secondary; font-size: 11px; font-weight: 700; horizontal-alignment: right; }
            }

            // track list
            Rectangle {
            width: 100%;
            height: 100%;
                vertical-stretch: 1;
                if root.results.length > 0:
                    Flickable {
                    width: 100%;
                    height: 100%;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for t in root.results: TrackRow {
                                palette: root.palette;
                                track: t;
                                clicked(id) => root.play-requested(id);
                            }
                        }
                    }
                if root.results.length == 0 && root.status != "":
                    Text {
                        text: root.status;
                        color: root.palette.text-secondary;
                    }
            }
        }
    }

    // ----------------------------------------------------------------
    // SETTINGS VIEW
    // ----------------------------------------------------------------
    if root.current-view == "settings": Rectangle {
    width: 100%;
    height: 100%;
        background: root.palette.bg;
        Flickable {
        width: 100%;
        height: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: root.palette.spacing;
                padding: 4px;
                Text {
                    text: @tr("Settings");
                    font-size: 22px;
                    font-weight: 800;
                    color: root.palette.text;
                }

                // --- Appearance -------------------------------------------------
                Rectangle {
                    border-radius: root.palette.radius + 4px;
                    background: root.palette.surface;
                    border-width: 1px;
                    border-color: root.palette.surface2;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: @tr("Appearance");
                            font-size: 13px;
                            font-weight: 700;
                            color: root.palette.text-secondary;
                        }
                        // Theme tiles (mini previews)
                        HorizontalLayout { spacing: 12px;
                            Rectangle { width: 96px; height: 74px;
                                dark-ta := TouchArea { clicked => root.theme-changed("breezer-dark"); mouse-cursor: pointer; }
                                VerticalLayout { spacing: 6px;
                                    Rectangle {
                                        width: 96px; height: 50px; border-radius: root.palette.radius;
                                        border-width: 2px;
                                        border-color: root.theme-id == "breezer-dark" ? root.palette.primary : root.palette.surface2;
                                        // mini window mock
                                        Rectangle { x: 0px; y: 0px; width: 26px; height: 50px; background: #1a1d24; }
                                        Rectangle { x: 30px; y: 8px; width: 22px; height: 8px; border-radius: 4px; background: root.palette.primary; }
                                        Rectangle { x: 30px; y: 20px; width: 56px; height: 22px; border-radius: 5px; background: root.palette.bg; }
                                    }
                                    Text { text: "Dark"; font-size: 11px; font-weight: 700;
                                        color: root.theme-id == "breezer-dark" ? root.palette.primary : root.palette.text;
                                        horizontal-alignment: center; }
                                }
                            }
                            Rectangle { width: 96px; height: 74px;
                                light-ta := TouchArea { clicked => root.theme-changed("breezer-light"); mouse-cursor: pointer; }
                                VerticalLayout { spacing: 6px;
                                    Rectangle {
                                        width: 96px; height: 50px; border-radius: root.palette.radius;
                                        border-width: 2px;
                                        border-color: root.theme-id == "breezer-light" ? root.palette.primary : root.palette.surface2;
                                        Rectangle { x: 0px; y: 0px; width: 26px; height: 50px; background: #dfe2e8; }
                                        Rectangle { x: 30px; y: 8px; width: 22px; height: 8px; border-radius: 4px; background: root.palette.primary; }
                                        Rectangle { x: 30px; y: 20px; width: 56px; height: 22px; border-radius: 5px; background: root.palette.bg; }
                                    }
                                    Text { text: "Light"; font-size: 11px; font-weight: 700;
                                        color: root.theme-id == "breezer-light" ? root.palette.primary : root.palette.text;
                                        horizontal-alignment: center; }
                                }
                            }
                            Rectangle { width: 96px; height: 74px;
                                amoled-ta := TouchArea { clicked => root.theme-changed("breezer-amoled"); mouse-cursor: pointer; }
                                VerticalLayout { spacing: 6px;
                                    Rectangle {
                                        width: 96px; height: 50px; border-radius: root.palette.radius;
                                        border-width: 2px;
                                        border-color: root.theme-id == "breezer-amoled" ? root.palette.primary : root.palette.surface2;
                                        Rectangle { x: 0px; y: 0px; width: 26px; height: 50px; background: #000000; }
                                        Rectangle { x: 30px; y: 8px; width: 22px; height: 8px; border-radius: 4px; background: root.palette.primary; }
                                        Rectangle { x: 30px; y: 20px; width: 56px; height: 22px; border-radius: 5px; background: root.palette.bg; }
                                    }
                                    Text { text: "AMOLED"; font-size: 11px; font-weight: 700;
                                        color: root.theme-id == "breezer-amoled" ? root.palette.primary : root.palette.text;
                                        horizontal-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.palette.surface2; }
                        Text { text: @tr("Language"); font-size: 13px; font-weight: 700; color: root.palette.text; }
                        HorizontalLayout { spacing: 8px;
                            Chip { palette: root.palette; label: "English"; active: root.ui-language == "en"; clicked => root.language-changed("en"); }
                            Chip { palette: root.palette; label: "Français"; active: root.ui-language == "fr"; clicked => root.language-changed("fr"); }
                        }
                        Rectangle { height: 1px; background: root.palette.surface2; }
                        Text { text: @tr("UI zoom") + "  (Ctrl + / −)"; font-size: 13px; font-weight: 700; color: root.palette.text; }
                        HorizontalLayout { spacing: 10px; alignment: center;
                            Rectangle {
                                width: 34px; height: 30px; border-radius: root.palette.radius;
                                background: zta.has-hover ? root.palette.surface2 : root.palette.surface2;
                                zta := TouchArea { clicked => root.zoom-out-requested(); mouse-cursor: pointer; }
                                Text { text: "−"; color: root.palette.text; width: 100%; height: 100%;
                                    horizontal-alignment: center; vertical-alignment: center; font-size: 15px; font-weight: 800; }
                            }
                            Text {
                                text: Math.round(root.ui-zoom * 100.0) + " %";
                                color: root.palette.text; font-size: 13px; font-weight: 700;
                                width: 52px; horizontal-alignment: center;
                            }
                            Rectangle {
                                width: 34px; height: 30px; border-radius: root.palette.radius;
                                background: root.palette.surface2;
                                zta2 := TouchArea { clicked => root.zoom-in-requested(); mouse-cursor: pointer; }
                                Text { text: "+"; color: root.palette.text; width: 100%; height: 100%;
                                    horizontal-alignment: center; vertical-alignment: center; font-size: 15px; font-weight: 800; }
                            }
                            SettingsBtn { palette: root.palette; label: @tr("Reset"); clicked => root.zoom-reset-requested(); }
                        }
                    }
                }

                // --- Customization ---------------------------------------------
                Rectangle {
                    border-radius: root.palette.radius + 4px;
                    background: root.palette.surface;
                    border-width: 1px;
                    border-color: root.palette.surface2;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: @tr("Customization");
                            font-size: 13px;
                            font-weight: 700;
                            color: root.palette.text-secondary;
                        }
                        Rectangle {
                            height: 34px;
                            border-radius: root.palette.radius;
                            background: root.palette.surface2;
                            TouchArea {
                                clicked => { root.show-theme-editor = !root.show-theme-editor; }
                                mouse-cursor: pointer;
                            }
                            Text {
                                text: @tr("Custom colors");
                                color: root.palette.text;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-theme-editor: VerticalLayout { spacing: 8px;
                            ColorRow { palette: root.palette; token: "bg"; label: "bg"; hint: @tr("ex: #0f1012"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "surface"; label: "surface"; hint: @tr("ex: #17181c"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "surface2"; label: "surface2"; hint: @tr("ex: #1f2127"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "primary"; label: "primary"; hint: @tr("ex: #a238ff"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "accent"; label: "accent"; hint: @tr("ex: #2a9d8f"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "text"; label: "text"; hint: @tr("ex: #f2f3f5"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "error"; label: "error"; hint: @tr("ex: #e5484d"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "radius"; label: "radius"; hint: @tr("px, ex: 8"); changed(t, v) => root.theme-override-requested(t, v); }
                            ColorRow { palette: root.palette; token: "spacing"; label: "spacing"; hint: @tr("px, ex: 12"); changed(t, v) => root.theme-override-requested(t, v); }
                            Text {
                                text: @tr("Type a value and press Enter to apply.");
                                color: root.palette.text-secondary;
                                font-size: 11px;
                            }
                            SettingsBtn { palette: root.palette; label: @tr("Reset custom colors"); clicked => root.reset-theme-overrides-requested(); }
                        }
                    }
                }

                // --- Layout -----------------------------------------------------
                Rectangle {
                    border-radius: root.palette.radius + 4px;
                    background: root.palette.surface;
                    border-width: 1px;
                    border-color: root.palette.surface2;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: @tr("Layout");
                            font-size: 13px;
                            font-weight: 700;
                            color: root.palette.text-secondary;
                        }
                        HorizontalLayout { spacing: 8px;
                            SettingsBtn { palette: root.palette; label: @tr("Show queue"); clicked => root.toggle-right-panel-requested(); }
                            SettingsBtn { palette: root.palette; label: @tr("Save layout"); clicked => root.save-layout-requested(); }
                            SettingsBtn { palette: root.palette; label: @tr("Reset layout"); clicked => root.reset-layout-requested(); }
                        }
                    }
                }

                // --- About ------------------------------------------------------
                Rectangle {
                    border-radius: root.palette.radius + 4px;
                    background: root.palette.surface;
                    border-width: 1px;
                    border-color: root.palette.surface2;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        Text {
                            text: @tr("About");
                            font-size: 13px;
                            font-weight: 700;
                            color: root.palette.text-secondary;
                        }
                        Text {
                            text: @tr("Breezer v0.1 — AGPL-3.0");
                            color: root.palette.text;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Independent client, not affiliated with Deezer.");
                            color: root.palette.text-secondary;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}