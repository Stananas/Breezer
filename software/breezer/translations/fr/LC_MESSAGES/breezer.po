msgid "Welcome to Breezer"
msgstr "Bienvenue sur Breezer"

msgid "Tailor Breezer to your taste"
msgstr "Personnalisez Breezer à votre goût"

msgid "Connect your Deezer account (required)"
msgstr "Connectez votre compte Deezer (obligatoire)"

msgid "1. Open Deezer · 2. Copy your ARL cookie · 3. Paste & connect"
